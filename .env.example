# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: Optional Google OAuth Client ID for Google Authentication
VITE_GOOGLE_CLIENT_ID=""

# FIREBASE_PROJECT_ID: Firebase project ID for server-side auth token verification
FIREBASE_PROJECT_ID="smartpdf-c2800"

# FIREBASE_CLIENT_EMAIL: Optional Firebase Admin service account client email
FIREBASE_CLIENT_EMAIL=""

# FIREBASE_PRIVATE_KEY: Optional Firebase Admin service account private key
FIREBASE_PRIVATE_KEY=""

# FREE_AI_DAILY_REQUEST_LIMIT: Daily AI request quota for free tier users (Default: 20)
FREE_AI_DAILY_REQUEST_LIMIT="20"

# PRO_AI_DAILY_REQUEST_LIMIT: Daily AI request quota for pro tier users (Default: 200)
PRO_AI_DAILY_REQUEST_LIMIT="200"

# GEMINI PRICING TELEMETRY (Cost estimation per 1M tokens)
GEMINI_INPUT_COST_PER_MILLION="0.075"
GEMINI_OUTPUT_COST_PER_MILLION="0.30"

# ENABLE_DEV_MOCK_AUTH: Set to true to allow development mock auth tokens in dev mode (Default: false)
ENABLE_DEV_MOCK_AUTH="true"

# STRIPE PAYMENT CONFIGURATION
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_ENTERPRISE_PRICE_ID=""

# RAZORPAY PAYMENT CONFIGURATION
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
